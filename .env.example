SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback
SECRET_KEY=any_random_string_you_make_up

# Optional — uncomment and fill in to enable the Plex tools.
# Leave commented out (or blank) and the Plex nav stays hidden.
#PLEX_URL=http://localhost:32400
#PLEX_TOKEN=your_plex_token_here

# Optional — only used by the `mix` Claude Code skill for artist tag lookups.
# Free key from https://www.last.fm/api/account/create
LASTFM_API_KEY=
